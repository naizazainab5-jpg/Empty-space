# Firebase Console > Project settings > Your apps > Web app config.
# These are public web-app identifiers, not a substitute for Firestore Security Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Local-only demo mode. Uses Firebase Auth/Firestore emulators and skips App Check
# and Cloud Functions. Do not use this setting against a live Firebase project.
# VITE_DEMO_MODE=true

# Optional: use local Firebase emulators for development only.
# Set VITE_USE_FIREBASE_EMULATORS=true after starting the Auth and Firestore emulators.
# VITE_USE_FIREBASE_EMULATORS=true

# Optional: set a CORS-enabled, Nominatim-compatible reverse-geocoding endpoint.
# Use a service you are authorized to call; do not put private API keys in VITE_ variables.
# Leave blank to use manual district/locality search without place-name lookup.
VITE_GEOCODING_ENDPOINT=
